# === Auburn Credentials ===
AUBURN_USERNAME=your_username
AUBURN_PASSWORD=your_password

# === Course Configuration ===
# Comma-separated list of courses to monitor (e.g., "ELEC 2200,MATH 2660")
COURSES=ELEC 2200,MATH 2660

# Check interval in seconds
CHECK_INTERVAL=60

# TigerSchedule term code (data-term attribute on the term picker page)
# e.g. 202610 = Fall 2025; confirm the current code on the site
TERM_CODE=202720

# Seconds to wait for login to complete, including approving Duo
LOGIN_TIMEOUT=180

# === Seat Watcher (watch.py, alerts only, no login needed) ===
# Watches COURSES and TERM_CODE above. Optionally narrow a course to specific sections:
WATCH_CRNS=
# Random wait between checks, in minutes (never less than 3)
WATCH_MIN_MINUTES=5
WATCH_MAX_MINUTES=15
# No checks during these hours (local time, 24h); blank to check around the clock
QUIET_HOURS=23-7
# Stop on this date (YYYY-MM-DD); blank stops after 21 days
WATCH_UNTIL=
# Phone alerts: install the ntfy app and subscribe to a hard-to-guess topic name
NTFY_TOPIC=

# === Email Notification Settings ===
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SENDER_EMAIL=your_email@gmail.com
SENDER_PASSWORD=your_app_password
RECIPIENT_EMAIL=your_email@gmail.com
EMAIL_NOTIFICATIONS_ENABLED=false

# === Browser Settings ===
HEADLESS=false
