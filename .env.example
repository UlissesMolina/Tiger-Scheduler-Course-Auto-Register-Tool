# === Auburn Credentials ===
AUBURN_USERNAME=your_username
AUBURN_PASSWORD=your_password

# === Course Configuration ===
# Comma-separated list of courses to monitor (e.g., "ELEC 2200,MATH 2660")
COURSES=ELEC 2200,MATH 2660

# Check interval in seconds
CHECK_INTERVAL=60

# TigerSchedule term code (data-term attribute on the term picker page)
# e.g. 202610 = Fall 2025; confirm the current code on the site
TERM_CODE=202720

# Seconds to wait for login to complete, including approving Duo
LOGIN_TIMEOUT=180

# === Email Notification Settings ===
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SENDER_EMAIL=your_email@gmail.com
SENDER_PASSWORD=your_app_password
RECIPIENT_EMAIL=your_email@gmail.com
EMAIL_NOTIFICATIONS_ENABLED=false

# === Browser Settings ===
HEADLESS=false
